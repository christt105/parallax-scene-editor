{
  "format": "parallax-scene/1",
  "name": "demo",
  "canvas": [640, 360],
  "zoom": 2,
  "world_height": 160,
  "align": "bottom",
  "loop_frames": 256,
  "fps": 24,
  "backdrop": "#568cc4",
  "sprite_root": "assets",
  "layers": [
    {
      "name": "sky",
      "sprite": "layers/sky.png",
      "y": 0,
      "depth": -150,
      "speed": 0,
      "tile_period": 320,
      "extend_up": true
    },
    {
      "name": "far hills",
      "sprite": "layers/hills_far.png",
      "y": 56,
      "depth": -140,
      "speed": 1,
      "tile_period": 256
    },
    {
      "name": "near hills",
      "sprite": "layers/hills_near.png",
      "y": 68,
      "depth": -130,
      "speed": 2,
      "tile_period": 256
    },
    {
      "name": "trees",
      "sprite": "layers/trees.png",
      "y": 74,
      "depth": -120,
      "speed": 3,
      "tile_period": 256
    },
    {
      "name": "ground",
      "sprite": "layers/ground.png",
      "y": 122,
      "depth": -110,
      "speed": 4,
      "tile_period": 256,
      "extend_down": true
    },
    {
      "name": "front grass",
      "sprite": "layers/grass_front.png",
      "y": 146,
      "depth": 100,
      "speed": 6,
      "tile_period": 256
    }
  ],
  "actors": [
    {
      "name": "runner",
      "sprite": "sprites/walker.png",
      "frames": 4,
      "delay": 4,
      "x": 96,
      "y": 150,
      "anchor": "bottom-center",
      "depth": 20,
      "motion": [
        { "type": "wobble", "axis": "y", "amp": 1, "hold": 8 }
      ]
    },
    {
      "name": "bird",
      "sprite": "sprites/bird.png",
      "frames": 2,
      "delay": 4,
      "anchor": "center",
      "depth": 10,
      "flip_x": true,
      "keys": [
        { "f": 0, "x": 352, "y": 46, "ease": "linear" },
        { "f": 144, "x": -32, "y": 30, "ease": "linear" },
        { "f": 255, "x": -32, "y": 30, "ease": "linear" }
      ],
      "motion": [
        { "type": "sine", "axis": "y", "amp": 3, "period": 32 }
      ]
    },
    {
      "name": "cloud",
      "sprite": "sprites/cloud.png",
      "frames": 1,
      "delay": 1,
      "anchor": "center",
      "depth": -145,
      "opacity": 0.9,
      "keys": [
        { "f": 0, "x": 348, "y": 34, "ease": "linear" },
        { "f": 255, "x": -28, "y": 34, "ease": "linear" }
      ]
    }
  ]
}
